{
  "name": "@netlab/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "netlab": "./src/main.ts"
  },
  "scripts": {
    "test": "bun test",
    "gen-manifest": "bun scripts/gen-manifest.ts",
    "compile": "bun scripts/gen-manifest.ts && mkdir -p ../../dist && bun build --compile src/main.ts --outfile ../../dist/netlab"
  },
  "dependencies": {
    "@netlab/bytes": "workspace:*",
    "@netlab/core": "workspace:*",
    "@netlab/exercises": "workspace:*",
    "@netlab/pcap": "workspace:*",
    "@netlab/protocols": "workspace:*",
    "@netlab/shell": "workspace:*"
  }
}
