{
  "version": 1,
  "id": "l2-flood-vs-learn",
  "title": "Hub que inunda vs switch que aprende",
  "kind": "configurar",
  "objective": "El segmento de h1/h2 está detrás de un hub y el de h3/h4 detrás de un switch. Reemplazá el hub por un switch sw2, cableá h1 y h2 en p1 y p2, y verificá que ambos switches aprenden las MACs en el puerto correcto.",
  "seed": 1001,
  "until": "3s",
  "base": {
    "version": 1,
    "seed": 1001,
    "nodes": [
      {
        "type": "host",
        "id": "h1",
        "interfaces": [
          {
            "name": "eth0",
            "mac": "02:00:00:00:00:0a",
            "ip": "10.0.0.1",
            "mask": "255.255.255.0"
          }
        ]
      },
      {
        "type": "host",
        "id": "h2",
        "interfaces": [
          {
            "name": "eth0",
            "mac": "02:00:00:00:00:0b",
            "ip": "10.0.0.2",
            "mask": "255.255.255.0"
          }
        ]
      },
      {
        "type": "host",
        "id": "h3",
        "interfaces": [
          {
            "name": "eth0",
            "mac": "02:00:00:00:00:0c",
            "ip": "10.0.1.1",
            "mask": "255.255.255.0"
          }
        ]
      },
      {
        "type": "host",
        "id": "h4",
        "interfaces": [
          {
            "name": "eth0",
            "mac": "02:00:00:00:00:0d",
            "ip": "10.0.1.2",
            "mask": "255.255.255.0"
          }
        ]
      },
      {
        "type": "hub",
        "id": "hub1",
        "ports": [
          {
            "name": "p1"
          },
          {
            "name": "p2"
          }
        ]
      },
      {
        "type": "switch",
        "id": "sw1",
        "ports": [
          {
            "name": "p1"
          },
          {
            "name": "p2"
          }
        ]
      }
    ],
    "links": [
      {
        "id": "l1",
        "a": {
          "node": "h1",
          "iface": "eth0"
        },
        "b": {
          "node": "hub1",
          "iface": "p1"
        },
        "params": {
          "latencyUs": 10
        }
      },
      {
        "id": "l2",
        "a": {
          "node": "h2",
          "iface": "eth0"
        },
        "b": {
          "node": "hub1",
          "iface": "p2"
        },
        "params": {
          "latencyUs": 10
        }
      },
      {
        "id": "l3",
        "a": {
          "node": "h3",
          "iface": "eth0"
        },
        "b": {
          "node": "sw1",
          "iface": "p1"
        },
        "params": {
          "latencyUs": 10
        }
      },
      {
        "id": "l4",
        "a": {
          "node": "h4",
          "iface": "eth0"
        },
        "b": {
          "node": "sw1",
          "iface": "p2"
        },
        "params": {
          "latencyUs": 10
        }
      }
    ],
    "actions": [
      {
        "at": 0,
        "host": "h3",
        "exec": "ping -c 1 10.0.1.2"
      },
      {
        "at": "500ms",
        "host": "h4",
        "exec": "help"
      }
    ]
  },
  "hints": [
    {
      "level": 1,
      "text": "Un hub repite cada frame por todos los puertos; un switch aprende la MAC de origen y filtra el unicast conocido.",
      "penalty": 5
    },
    {
      "level": 2,
      "text": "Cambiá el nodo hub1 por un switch sw2 con puertos p1 y p2, y dejá los cables l1/l2 apuntando a esos puertos.",
      "penalty": 15
    }
  ],
  "checks": [
    {
      "type": "ping",
      "name": "h1 reaches h2 on the switched segment",
      "from": "h1",
      "to": "h2",
      "minReplies": 1
    },
    {
      "type": "macTable",
      "name": "sw2 learns h1 on p1",
      "switch": "sw2",
      "mac": "02:00:00:00:00:0a",
      "port": "p1"
    },
    {
      "type": "macTable",
      "name": "sw2 learns h2 on p2",
      "switch": "sw2",
      "mac": "02:00:00:00:00:0b",
      "port": "p2"
    },
    {
      "type": "macTable",
      "name": "sw1 learns h3 on p1",
      "switch": "sw1",
      "mac": "02:00:00:00:00:0c",
      "port": "p1"
    }
  ]
}
