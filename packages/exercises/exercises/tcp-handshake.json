{
  "version": 1,
  "id": "tcp-handshake",
  "title": "Handshake TCP paso a paso",
  "kind": "construir",
  "objective": "h2 debe escuchar HTTP en el puerto 80 y h1 debe completar el three-way handshake hasta ESTABLISHED. Levantá el servidor y verificá el estado con nc y ss.",
  "seed": 1018,
  "until": "4s",
  "base": {
    "version": 1,
    "seed": 1018,
    "nodes": [
      {
        "type": "host",
        "id": "h1",
        "interfaces": [
          {
            "name": "eth0",
            "mac": "02:00:00:00:00:0a",
            "ip": "10.0.0.1",
            "mask": "255.255.255.0"
          }
        ]
      },
      {
        "type": "host",
        "id": "h2",
        "interfaces": [
          {
            "name": "eth0",
            "mac": "02:00:00:00:00:0b",
            "ip": "10.0.0.2",
            "mask": "255.255.255.0"
          }
        ]
      },
      {
        "type": "switch",
        "id": "sw1",
        "ports": [
          {
            "name": "p1"
          },
          {
            "name": "p2"
          }
        ]
      }
    ],
    "links": [
      {
        "id": "l1",
        "a": {
          "node": "h1",
          "iface": "eth0"
        },
        "b": {
          "node": "sw1",
          "iface": "p1"
        },
        "params": {
          "latencyUs": 10
        }
      },
      {
        "id": "l2",
        "a": {
          "node": "h2",
          "iface": "eth0"
        },
        "b": {
          "node": "sw1",
          "iface": "p2"
        },
        "params": {
          "latencyUs": 10
        }
      }
    ],
    "actions": []
  },
  "hints": [
    {
      "level": 1,
      "text": "Sin listener, el SYN recibe RST y nc informa connect: refused; el handshake necesita un socket en LISTEN.",
      "penalty": 5
    },
    {
      "level": 2,
      "text": "Ejecutá http-server en h2 (puerto 80 por defecto) antes de que h1 haga nc.",
      "penalty": 10
    }
  ],
  "checks": [
    {
      "type": "exec",
      "name": "nc completes the three-way handshake",
      "host": "h1",
      "command": "nc 10.0.0.2 80",
      "expect": {
        "stdoutMatches": "state ESTABLISHED"
      }
    }
  ]
}
